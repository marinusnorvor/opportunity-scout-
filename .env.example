# ==========================================
# Google Sheets Configuration
# ==========================================
# The ID of your Google Sheet (from URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Paste the raw JSON string of your Google Cloud Service Account key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Or provide a path to a local credentials file
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service_account.json

# ==========================================
# Email Notification Configuration (SMTP)
# ==========================================
# For Gmail, host is smtp.gmail.com, port 587 or 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, use an "App Password" generated in Google Account Security
SMTP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# ==========================================
# Optional Settings
# ==========================================
# Run mode: DRY_RUN=true skips sending real emails or writing to real sheets
DRY_RUN=false

# Optional Gemini API key if you want LLM-powered deep reasoning (fallback is heuristic rules)
GEMINI_API_KEY=
